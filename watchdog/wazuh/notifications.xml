<!-- Fragments for the manager's ossec_config. Merge alerts settings with existing ones.
     Configure global email_notification, SMTP, sender and recipient separately.
     Lowering the global email threshold affects all email routing. -->
<alerts>
  <log_alert_level>3</log_alert_level>
  <email_alert_level>5</email_alert_level>
</alerts>
<email_alerts>
  <email_to>security@example.invalid</email_to>
  <level>5</level>
  <rule_id>100710, 100711, 100714, 100715</rule_id>
  <do_not_delay/>
  <do_not_group/>
</email_alerts>
<!-- Optional Slack example; replace with a real hook and protect configuration. -->
<integration>
  <name>slack</name>
  <hook_url>https://example.invalid/slack-webhook</hook_url>
  <rule_id>100710,100711,100714,100715</rule_id>
  <alert_format>json</alert_format>
</integration>
<!-- A custom webhook requires a separately implemented manager executable named
     custom-watch-webhook in /var/ossec/integrations; this repository supplies none.
<integration>
  <name>custom-watch-webhook</name>
  <hook_url>https://example.invalid/webhook</hook_url>
  <rule_id>100710,100711,100714,100715</rule_id>
  <alert_format>json</alert_format>
</integration>
-->
